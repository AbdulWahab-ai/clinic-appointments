# Copy to .env and adjust. Every variable is validated at startup by src/env.ts.
# Never commit .env. Values below work with `docker compose up -d` out of the box.

# ---------------------------------------------------------------- core
NODE_ENV=development
# Public base URL of the app (used in links, OAuth callbacks, .ics files).
APP_URL=http://localhost:3000
# Root domain for clinic subdomains ({slug}.ROOT_DOMAIN). Leave empty to use /c/{slug} paths only.
ROOT_DOMAIN=
# debug | info | warn | error
LOG_LEVEL=debug

# ---------------------------------------------------------------- database / cache
DATABASE_URL=postgresql://clinic:clinic@localhost:5432/clinic
# Used by integration tests only. Must point at a database you're happy to wipe.
TEST_DATABASE_URL=postgresql://clinic:clinic@localhost:5432/clinic_test
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- auth (Better Auth)
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-0000000000
# Staff sessions expire after this many minutes without activity.
STAFF_IDLE_TIMEOUT_MINUTES=30
# on | off. Leave on. Playwright turns it off for its own server (many sign-ins from one IP).
AUTH_RATE_LIMIT=on
# Google sign-in is disabled unless both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- encryption
# Field-level encryption for medical notes, form answers, tokens.
# Format: "<version>:<base64 32-byte key>", comma separated; the first is used for new writes.
# Generate: node -e "console.log('v1:'+require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEYS=v1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ---------------------------------------------------------------- providers
# Each integration has a mock implementation. "console" logs + stores in the dev outbox (/dev/outbox).
SMS_PROVIDER=console
EMAIL_PROVIDER=smtp
EMAIL_FROM="Clinic Appointments <no-reply@clinic.local>"
# Mailpit from docker-compose. Real SMTP: set host/port/user/pass.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# ---------------------------------------------------------------- storage
# "local" stores files on disk under STORAGE_LOCAL_DIR and serves them via HMAC-signed URLs.
# "s3" (Phase 7) uses any S3-compatible service (AWS S3, Cloudflare R2).
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.data/uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- observability
# Sentry is disabled when empty.
SENTRY_DSN=

# Mock-message inbox (/en/dev/outbox) is always on outside production. Set true only for CI
# end-to-end runs against a production build. Never in a real deployment: it shows OTP codes.
ENABLE_DEV_OUTBOX=false

# ---------------------------------------------------------------- seed
# Password for every seeded demo account (dev only).
SEED_PASSWORD=Demo-Clinic-2026!
